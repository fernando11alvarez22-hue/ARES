<!doctype html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>A.R.E.S.</title>
<style>
:root{--bg:#050003;--red:#ff1e3c;--crim:#b0102a;--dim:#4a0814;--txt:#ffd9de;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{height:100%;margin:0;background:var(--bg);color:var(--txt);font-family:"Segoe UI",Roboto,system-ui,sans-serif;overflow:hidden}
*{box-sizing:border-box}
#app{height:100%;display:flex;flex-direction:column;position:relative}
header{display:flex;align-items:center;justify-content:space-between;padding:10px 16px}
.logo{font-weight:700;letter-spacing:.35em;color:var(--red);text-shadow:0 0 12px var(--red)}
#status{font-size:11px;letter-spacing:.2em;color:#ff8093;text-transform:uppercase}
.ib{background:none;border:1px solid var(--dim);color:var(--red);border-radius:10px;width:38px;height:38px;font-size:18px;box-shadow:0 0 10px #ff1e3c22 inset}
#stage{flex:1;position:relative;min-height:0}
canvas{width:100%;height:100%;display:block}
#caption{position:absolute;left:14px;right:14px;bottom:6px;max-height:84px;overflow:auto;padding:8px 12px;border:1px solid var(--dim);border-radius:12px;background:#12000866;backdrop-filter:blur(6px);font-size:14px;line-height:1.35;display:none}
#chips{display:flex;gap:8px;overflow-x:auto;padding:8px 14px}
.chip{flex:none;border:1px solid var(--crim);color:var(--txt);background:#1a000a99;border-radius:999px;padding:7px 13px;font-size:13px}
#bar{display:flex;gap:8px;padding:6px 14px 12px}
#inp{flex:1;min-width:0;background:#10000799;border:1px solid var(--crim);border-radius:14px;color:var(--txt);padding:11px 14px;font-size:16px;outline:none}
#inp:focus{box-shadow:0 0 12px #ff1e3c66}
.btn{border:1px solid var(--red);background:#2a0010;color:#fff;border-radius:14px;min-width:46px;font-size:18px;box-shadow:0 0 12px #ff1e3c44}
.btn.on{background:var(--red);box-shadow:0 0 22px var(--red)}
.sheet{position:absolute;inset:0;background:#050003f2;display:none;flex-direction:column;z-index:5;padding-top:env(safe-area-inset-top,0px)}
.sheet.open{display:flex}
.sh{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--dim);color:var(--red);letter-spacing:.2em;font-size:13px}
#msgs{flex:1;overflow-y:auto;padding:12px 14px;display:flex;flex-direction:column;gap:10px}
.m{max-width:86%;padding:10px 13px;border-radius:14px;font-size:15px;line-height:1.4;white-space:pre-wrap;word-wrap:break-word}
.m.u{align-self:flex-end;background:#3a0a18;border:1px solid var(--crim)}
.m.a{align-self:flex-start;background:#14000a;border:1px solid var(--dim);box-shadow:0 0 14px #ff1e3c18}
#set{padding:16px;display:flex;flex-direction:column;gap:18px;font-size:15px}
#set label{display:flex;justify-content:space-between;align-items:center;gap:12px}
#set input[type=range]{flex:1;accent-color:#ff1e3c}
#toast{position:absolute;top:60px;left:50%;transform:translateX(-50%);background:#2a0010;border:1px solid var(--red);padding:8px 14px;border-radius:10px;font-size:13px;z-index:9;display:none;max-width:90%;text-align:center}
</style></head><body>
<div id="app">
<header>
<button class="ib" id="bChat" title="Chat">&#9776;</button>
<div style="text-align:center"><div class="logo">A.R.E.S.</div><div id="status">en reposo</div></div>
<button class="ib" id="bSet" title="Ajustes">&#9881;</button>
</header>
<div id="stage"><canvas id="cv"></canvas><div id="caption"></div></div>
<div id="chips"></div>
<div id="bar">
<button class="btn" id="bMic" title="Escuchar">&#127908;</button>
<input id="inp" placeholder="Habla con ARES…" autocomplete="off" enterkeyhint="send">
<button class="btn" id="bSend" title="Enviar">&#10148;</button>
</div>
<div class="sheet" id="chat"><div class="sh"><span>HISTORIAL</span><button class="ib" data-close="chat">&#10005;</button></div><div id="msgs"></div></div>
<div class="sheet" id="settings"><div class="sh"><span>AJUSTES</span><button class="ib" data-close="settings">&#10005;</button></div>
<div id="set">
<label>Respuestas habladas <input type="checkbox" id="cVoice"></label>
<label>Velocidad <input type="range" id="cRate" min="0.6" max="1.6" step="0.1"></label>
<label>Volumen <input type="range" id="cVol" min="0" max="1" step="0.1"></label>
<label>Brillo del núcleo <input type="range" id="cGlow" min="0.5" max="1.5" step="0.1"></label>
<button class="chip" id="bClear" style="padding:12px">Borrar historial</button>
<div style="font-size:12px;color:#ff8093;line-height:1.5">A.R.E.S. v0.1 · La palabra de activación «Ares» aún no está implementada: el navegador no permite escuchar en segundo plano.</div>
</div></div>
<div id="toast"></div>
</div>
<script>
(function(){
"use strict";
var $=function(s){return document.querySelector(s)};
var cfg={voice:true,rate:1,vol:1,glow:1}, msgs=[], state="idle", sample=null, rec=null, busy=false, pulseAmp=0;
var PERSONA="Eres A.R.E.S., el asistente personal del usuario. Eres inteligente, leal, directo y resolutivo. Hablas en español natural, con personalidad propia y sin formalidad excesiva. Respondes claro y breve (esto se leerá en un móvil y quizá se dirá en voz alta: evita markdown, listas largas y emojis). Si no sabes algo, lo reconoces. Ayudas con tareas, ideas, explicaciones y organización.";
var CHIPS=[["Planificar mi día","Ayúdame a planificar mi día: hazme 3 preguntas cortas para empezar."],["Dame una idea","Dame una idea original para un proyecto que pueda hacer este fin de semana."],["Explícame algo","Explícame de forma sencilla algo interesante que casi nadie sabe."],["Organizar tareas","Quiero organizar mis tareas pendientes. Dime cómo empezamos."]];
function toast(t){var e=$("#toast");e.textContent=t;e.style.display="block";clearTimeout(toast.t);toast.t=setTimeout(function(){e.style.display="none"},3500)}
function store(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
function fetchStore(k,d){try{var v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return d}}
cfg=Object.assign(cfg,fetchStore("ares_cfg",{})); msgs=fetchStore("ares_msgs",[]);
var LABEL={idle:"en reposo",listening:"escuchando",thinking:"procesando",speaking:"respondiendo"};
function setState(s){state=s;$("#status").textContent=LABEL[s];$("#bMic").classList.toggle("on",s==="listening")}
function addBubble(role,text){var d=document.createElement("div");d.className="m "+(role==="user"?"u":"a");d.textContent=text;$("#msgs").appendChild(d);$("#msgs").scrollTop=1e9;return d}
function caption(t){var c=$("#caption");c.style.display=t?"block":"none";c.textContent=t||"";c.scrollTop=1e9}
msgs.forEach(function(m){addBubble(m.role,m.content)});
if(msgs.length){var l=msgs[msgs.length-1];if(l.role==="assistant")caption(l.content)}
// ---------- IA real (Claude vía capacidad "sample") ----------
if(window.claude&&window.claude.use){window.claude.use("sample").then(function(s){sample=s;if(!s)toast("IA no disponible: abre A.R.E.S. desde su enlace en claude.ai")}).catch(function(){})}
else toast("IA no disponible fuera de claude.ai")
function send(text){
 text=(text||"").trim(); if(!text||busy)return;
 if(!sample){toast("La IA aún no está disponible. Espera un momento o abre el enlace desde claude.ai");return}
 stopSpeak(); if(rec)rec.abort();
 busy=true;$("#inp").value="";
 msgs.push({role:"user",content:text});addBubble("user",text);caption("");setState("thinking");
 var hist=msgs.slice(-14).map(function(m){return{role:m.role,content:m.content}});
 hist[0]={role:"user",content:PERSONA+"\n\n---\n"+(hist[0].role==="user"?hist[0].content:"Hola")};
 if(hist[0].role!=="user")hist.shift();
 var b=addBubble("assistant","…");
 sample(hist,{cache:false,onText:function(o){b.textContent=o.text;caption(o.text);$("#msgs").scrollTop=1e9}}).then(function(r){
  var t=(r&&r.text)||"";b.textContent=t;caption(t);msgs.push({role:"assistant",content:t});store("ares_msgs",msgs.slice(-60));
  busy=false;speak(t)
 }).catch(function(e){
  busy=false;setState("idle");msgs.pop();b.textContent="No pude responder ("+((e&&e.code)||"error")+"). Inténtalo de nuevo.";
  toast(e&&e.code==="not_granted"?"Debes aceptar el permiso de la IA":"Error al contactar con la IA")
 })
}
// ---------- Voz: síntesis ----------
function pickVoice(){var v=speechSynthesis.getVoices();return v.filter(function(x){return /^es/i.test(x.lang)})[0]||null}
function speak(t){
 if(!cfg.voice||!window.speechSynthesis||!t){setState("idle");return}
 var u=new SpeechSynthesisUtterance(t);u.lang="es-ES";u.rate=cfg.rate;u.volume=cfg.vol;var v=pickVoice();if(v)u.voice=v;
 u.onstart=function(){setState("speaking")};u.onboundary=function(){pulseAmp=1};
 u.onend=u.onerror=function(){pulseAmp=0;if(state==="speaking")setState("idle")};
 speechSynthesis.cancel();setState("speaking");speechSynthesis.speak(u)
}
function stopSpeak(){if(window.speechSynthesis)speechSynthesis.cancel();pulseAmp=0}
// ---------- Voz: reconocimiento ----------
var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
function toggleMic(){
 if(rec){rec.stop();return}
 if(!SR){toast("Este navegador no soporta reconocimiento de voz. Prueba con Chrome.");return}
 if(busy)return; stopSpeak();
 var r=new SR(),got="";r.lang="es-ES";r.interimResults=true;r.continuous=false;rec=r;
 r.onstart=function(){setState("listening")};
 r.onresult=function(e){var s="";for(var i=0;i<e.results.length;i++)s+=e.results[i][0].transcript;got=s;$("#inp").value=s};
 r.onerror=function(e){toast(e.error==="not-allowed"||e.error==="service-not-allowed"?"Micrófono bloqueado: permite el acceso en el navegador":"Error de voz: "+e.error)};
 r.onend=function(){rec=null;if(got.trim())send(got);else if(state==="listening")setState("idle")};
 try{r.start()}catch(e){rec=null;toast("No se pudo iniciar el micrófono")}
}
// ---------- UI ----------
CHIPS.forEach(function(c){var b=document.createElement("button");b.className="chip";b.textContent=c[0];b.onclick=function(){send(c[1])};$("#chips").appendChild(b)});
$("#bSend").onclick=function(){send($("#inp").value)};
$("#inp").addEventListener("keydown",function(e){if(e.key==="Enter")send(this.value)});
$("#bMic").onclick=toggleMic;
$("#bChat").onclick=function(){$("#chat").classList.add("open");$("#msgs").scrollTop=1e9};
$("#bSet").onclick=function(){$("#settings").classList.add("open")};
document.querySelectorAll("[data-close]").forEach(function(b){b.onclick=function(){$("#"+b.dataset.close).classList.remove("open")}});
$("#cVoice").checked=cfg.voice;$("#cRate").value=cfg.rate;$("#cVol").value=cfg.vol;$("#cGlow").value=cfg.glow;
function bind(id,key,num){$(id).oninput=function(){cfg[key]=num?parseFloat(this.value):this.checked;if(key==="voice"&&!cfg.voice)stopSpeak();store("ares_cfg",cfg)}}
bind("#cVoice","voice",false);bind("#cRate","rate",true);bind("#cVol","vol",true);bind("#cGlow","glow",true);
$("#bClear").onclick=function(){msgs=[];store("ares_msgs",[]);$("#msgs").innerHTML="";caption("");toast("Historial borrado")};
// ---------- Núcleo reactor (canvas) ----------
var cv=$("#cv"),ctx=cv.getContext("2d"),W=0,H=0,dpr=Math.min(window.devicePixelRatio||1,2);
function resize(){var r=cv.getBoundingClientRect();W=r.width;H=r.height;cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0)}
window.addEventListener("resize",resize);resize();
var P=[];for(var i=0;i<80;i++)P.push({a:Math.random()*6.283,r:.25+Math.random()*.8,s:(Math.random()*.6+.2)*(Math.random()<.5?-1:1),z:Math.random()*1.6+.6});
var cur={spd:.25,en:.35},T={idle:{spd:.25,en:.35},listening:{spd:.6,en:.7},thinking:{spd:2.2,en:1},speaking:{spd:.9,en:.85}};
var ang=0,last=0;
function rgba(a){return"rgba(255,30,60,"+Math.max(0,Math.min(1,a))+")"}
function draw(ts){
 var t=ts/1000,dt=Math.min(.05,t-last);last=t;var g=T[state];
 cur.spd+=(g.spd-cur.spd)*.05;cur.en+=(g.en-cur.en)*.05;pulseAmp*=.94;
 ang+=dt*cur.spd;var en=cur.en*cfg.glow;
 var cx=W/2,cy=H/2,R=Math.min(W,H)*.45;ctx.clearRect(0,0,W,H);
 var pulse=state==="speaking"?pulseAmp*.6+.1*Math.sin(t*10):state==="listening"?.12*Math.sin(t*5):state==="thinking"?.05*Math.sin(t*14):.04*Math.sin(t*1.5);
 var gr=ctx.createRadialGradient(cx,cy,0,cx,cy,R*1.1);gr.addColorStop(0,rgba(.35*en));gr.addColorStop(.5,rgba(.1*en));gr.addColorStop(1,"rgba(0,0,0,0)");
 ctx.fillStyle=gr;ctx.fillRect(0,0,W,H);
 ctx.save();ctx.translate(cx,cy);ctx.shadowColor="#ff1e3c";ctx.shadowBlur=14*cfg.glow;
 // marcas exteriores
 ctx.strokeStyle=rgba(.55*en);ctx.lineWidth=1.5;
 for(var k=0;k<72;k++){var a=k/72*6.283+ang*.3,l=k%6===0?.07:.03;ctx.beginPath();ctx.moveTo(Math.cos(a)*R,Math.sin(a)*R);ctx.lineTo(Math.cos(a)*R*(1-l),Math.sin(a)*R*(1-l));ctx.stroke()}
 // anillos concéntricos con arcos y trazos
 var rings=[[.92,[60,18],1,2],[.78,[4,10],-1.6,1.5],[.64,[110,30,10,30],1.2,3],[.5,[2,7],-2.2,1.5],[.38,[40,12],2,2.5]];
 rings.forEach(function(q){ctx.setLineDash(q[1]);ctx.lineWidth=q[3];ctx.strokeStyle=rgba((.5+.4*Math.sin(t+q[0]*5))*en+.1);ctx.save();ctx.rotate(ang*q[2]);ctx.beginPath();ctx.arc(0,0,R*q[0]*(1+pulse*.15),0,6.283);ctx.stroke();ctx.restore()});
 ctx.setLineDash([]);
 // líneas de circuito
 ctx.lineWidth=1.2;ctx.strokeStyle=rgba(.6*en);
 for(var s=0;s<8;s++){ctx.save();ctx.rotate(s*.7854+ang*.15);var r1=R*.2,r2=R*.38,r3=R*.5;ctx.beginPath();ctx.moveTo(r1,0);ctx.lineTo(r2,0);ctx.lineTo(r2+R*.05,R*.05);ctx.lineTo(r3,R*.05);ctx.stroke();var f=(t*.8*cur.spd+s*.13)%1;ctx.fillStyle=rgba(.9);ctx.beginPath();ctx.arc(r1+(r3-r1)*f,0,2,0,6.283);ctx.fill();ctx.restore()}
 // ondas al escuchar
 if(state==="listening")for(var w=0;w<3;w++){var p=(t*.6+w/3)%1;ctx.strokeStyle=rgba((1-p)*.8);ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,R*(.2+p*.85),0,6.283);ctx.stroke()}
 // núcleo
 var cr=R*.17*(1+pulse);var cg=ctx.createRadialGradient(0,0,0,0,0,cr*1.6);cg.addColorStop(0,"#fff0f2");cg.addColorStop(.25,"#ff5a70");cg.addColorStop(.6,rgba(.9));cg.addColorStop(1,"rgba(120,0,20,0)");
 ctx.shadowBlur=30*cfg.glow;ctx.fillStyle=cg;ctx.beginPath();ctx.arc(0,0,cr*1.6,0,6.283);ctx.fill();
 // partículas
 ctx.globalCompositeOperation="lighter";ctx.shadowBlur=8;
 P.forEach(function(p){p.a+=dt*p.s*cur.spd*.8;var rr=R*p.r*(1+pulse*.1);ctx.fillStyle=rgba(.35+.5*en);ctx.beginPath();ctx.arc(Math.cos(p.a)*rr,Math.sin(p.a)*rr,p.z,0,6.283);ctx.fill()});
 ctx.restore();requestAnimationFrame(draw)
}
requestAnimationFrame(draw);
if(window.speechSynthesis)speechSynthesis.onvoiceschanged=function(){};
})();
</script></body></html>
